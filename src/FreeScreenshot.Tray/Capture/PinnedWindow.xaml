<Window x:Class="FreeScreenshot.Capture.PinnedWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FreeScreenshot — pinned"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        MouseLeftButtonDown="OnDragStart"
        KeyDown="OnKeyDown">
  <Grid>
    <Border BorderBrush="#FF2DD4BF" BorderThickness="2" CornerRadius="10">
      <Image x:Name="ShotImage" Stretch="None"/>
    </Border>
    <Button x:Name="CloseBtn" Width="20" Height="20" Margin="0,6,6,0"
            HorizontalAlignment="Right" VerticalAlignment="Top"
            Background="#E6112528" Foreground="#FFF0FAF7"
            BorderThickness="0" Cursor="Hand"
            FocusVisualStyle="{x:Null}"
            Content="×" FontSize="14" Padding="0"
            Click="OnClose"/>
  </Grid>
</Window>
