<Window x:Class="FreeScreenshot.Capture.EditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FreeScreenshot — Editor"
        Width="1040" Height="740"
        MinWidth="720" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.Bg.Base}"
        FontFamily="{DynamicResource Font.Ui}"
        Foreground="{DynamicResource Brush.Text.Primary}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="56"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="52"/>
    </Grid.RowDefinitions>

    <!-- Top toolbar -->
    <Border Grid.Row="0" Background="{DynamicResource Brush.Bg.Surface1}"
            BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="0,0,0,1">
      <DockPanel LastChildFill="False" Margin="16,0">
        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
          <!-- Tool buttons -->
          <RadioButton x:Name="ToolArrow" GroupName="tool" Style="{DynamicResource ToolBtn}"
                       IsChecked="True" ToolTip="Fletxa">
            <Path Width="20" Height="20" Stretch="Uniform"
                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                  StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  Data="M5 19 L19 5 M11 5 L19 5 L19 13"/>
          </RadioButton>
          <RadioButton x:Name="ToolRect" GroupName="tool" Style="{DynamicResource ToolBtn}" ToolTip="Rectangle">
            <Path Width="20" Height="20" Stretch="Uniform"
                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                  StrokeThickness="1.8"
                  Data="M3 3 L21 3 L21 21 L3 21 Z"/>
          </RadioButton>
          <RadioButton x:Name="ToolText" GroupName="tool" Style="{DynamicResource ToolBtn}" ToolTip="Text">
            <Path Width="20" Height="20" Stretch="Uniform"
                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                  StrokeThickness="1.8" StrokeStartLineCap="Round"
                  Data="M4 7 L4 4 L20 4 L20 7 M9 20 L15 20 M12 4 L12 20"/>
          </RadioButton>
          <RadioButton x:Name="ToolBlur" GroupName="tool" Style="{DynamicResource ToolBtn}" ToolTip="Difuminar">
            <Path Width="20" Height="20" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                  Data="M12 3 C 14 7 18 9 18 14 A 6 6 0 0 1 6 14 C 6 9 10 7 12 3 Z"/>
          </RadioButton>
          <RadioButton x:Name="ToolCrop" GroupName="tool" Style="{DynamicResource ToolBtn}" ToolTip="Retallar">
            <Path Width="20" Height="20" Stretch="Uniform"
                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                  StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  Data="M6 2 L6 16 L20 16 M2 6 L16 6 L16 20"/>
          </RadioButton>
          <RadioButton x:Name="ToolLine" GroupName="tool" Style="{DynamicResource ToolBtn}" ToolTip="Línia">
            <Path Width="20" Height="20" Stretch="Uniform"
                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                  StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  Data="M4 20 L20 4"/>
          </RadioButton>
          <RadioButton x:Name="ToolMark" GroupName="tool" Style="{DynamicResource ToolBtn}" ToolTip="Marcador">
            <Path Width="20" Height="20" Stretch="Uniform"
                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                  StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  Data="M5 16 L19 16 M5 12 L19 12 M5 8 L13 8"/>
          </RadioButton>
          <RadioButton x:Name="ToolNumber" GroupName="tool" Style="{DynamicResource ToolBtn}" ToolTip="Numerar (1, 2, 3)">
            <Grid Width="20" Height="20">
              <Ellipse Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                       StrokeThickness="1.8"/>
              <TextBlock Text="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                         FontSize="11" FontWeight="Bold"
                         Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
            </Grid>
          </RadioButton>

          <Separator Width="1" Height="22" Background="{DynamicResource Brush.Border.Subtle}" Margin="10,0"/>

          <!-- Color swatches -->
          <RadioButton x:Name="ColorLime"   GroupName="color" Style="{DynamicResource SwatchBtn}"
                       IsChecked="True" Tag="#2DD4BF" ToolTip="Teal"/>
          <RadioButton x:Name="ColorRed"    GroupName="color" Style="{DynamicResource SwatchBtn}"
                       Tag="#EF4444" ToolTip="Vermell"/>
          <RadioButton x:Name="ColorYellow" GroupName="color" Style="{DynamicResource SwatchBtn}"
                       Tag="#FBBF24" ToolTip="Groc"/>
          <RadioButton x:Name="ColorWhite"  GroupName="color" Style="{DynamicResource SwatchBtn}"
                       Tag="#F5F2EC" ToolTip="Blanc"/>
          <RadioButton x:Name="ColorDark"   GroupName="color" Style="{DynamicResource SwatchBtn}"
                       Tag="#1A1814" ToolTip="Fosc"/>

          <Separator Width="1" Height="22" Background="{DynamicResource Brush.Border.Subtle}" Margin="10,0"/>

          <!-- Stroke width -->
          <RadioButton x:Name="StrokeThin"   GroupName="stroke" Style="{DynamicResource StrokeBtn}"
                       Tag="2"  ToolTip="Fi">
            <Ellipse Width="6" Height="6"
                     Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
          </RadioButton>
          <RadioButton x:Name="StrokeMed"    GroupName="stroke" Style="{DynamicResource StrokeBtn}"
                       IsChecked="True" Tag="4" ToolTip="Mitjà">
            <Ellipse Width="10" Height="10"
                     Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
          </RadioButton>
          <RadioButton x:Name="StrokeThick" GroupName="stroke" Style="{DynamicResource StrokeBtn}"
                       Tag="7"  ToolTip="Gruixut">
            <Ellipse Width="14" Height="14"
                     Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
          </RadioButton>

          <Separator Width="1" Height="22" Background="{DynamicResource Brush.Border.Subtle}" Margin="10,0"/>

          <Button x:Name="UndoBtn" Style="{DynamicResource GhostIconBtn}" Click="OnUndo" ToolTip="Desfer">
            <Path Width="20" Height="20" Stretch="Uniform"
                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                  StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  Data="M3 7 L3 13 L9 13 M21 17 a9 9 0 0 0 -15 -6.7 L3 13"/>
          </Button>
        </StackPanel>

        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock x:Name="DimensionsText" Foreground="{DynamicResource Brush.Text.Muted}"
                     FontFamily="{DynamicResource Font.Mono}" FontSize="12" VerticalAlignment="Center"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Canvas -->
    <Border Grid.Row="1" Background="#FF14130F">
      <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
        <Grid x:Name="CanvasHost" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
          <Image x:Name="ShotImage" Stretch="None"/>
          <Canvas x:Name="OverlayCanvas" Background="Transparent"
                  MouseLeftButtonDown="OnCanvasDown"
                  MouseMove="OnCanvasMove"
                  MouseLeftButtonUp="OnCanvasUp"/>
        </Grid>
      </ScrollViewer>
    </Border>

    <!-- Bottom bar -->
    <Border Grid.Row="2" Background="{DynamicResource Brush.Bg.Surface1}"
            BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="0,1,0,0">
      <DockPanel LastChildFill="False" Margin="16,0">
        <Button x:Name="CancelBtn" DockPanel.Dock="Left" Padding="14,8"
                Background="Transparent" Foreground="{DynamicResource Brush.Text.Secondary}"
                BorderThickness="0" Cursor="Hand" Click="OnCancel"/>
        <Button x:Name="SaveBtn" DockPanel.Dock="Right" Padding="16,8" MinWidth="100"
                Background="{DynamicResource Brush.Accent.Base}"
                Foreground="#FF1A1814" BorderThickness="0"
                FontWeight="SemiBold" Cursor="Hand"
                Click="OnSave"/>
        <Button x:Name="CopyBtn" DockPanel.Dock="Right" Padding="14,8" Margin="0,0,8,0" MinWidth="100"
                Background="{DynamicResource Brush.Bg.Surface2}"
                Foreground="{DynamicResource Brush.Text.Primary}"
                BorderBrush="{DynamicResource Brush.Border.Subtle}" Cursor="Hand"
                Click="OnCopy"/>
      </DockPanel>
    </Border>
  </Grid>

  <Window.Resources>
    <Style x:Key="ToolBtn" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}"/>
      <Setter Property="Width" Value="40"/>
      <Setter Property="Height" Value="36"/>
      <Setter Property="Margin" Value="2,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="bd" Background="Transparent" CornerRadius="6">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.Bg.Surface2}"/>
                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#1F2DD4BF"/>
                <Setter Property="Foreground" Value="{DynamicResource Brush.Accent.Base}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="GhostIconBtn" TargetType="Button">
      <Setter Property="Width" Value="40"/>
      <Setter Property="Height" Value="36"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="Transparent" CornerRadius="6">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.Bg.Surface2}"/>
                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SwatchBtn" TargetType="RadioButton">
      <Setter Property="Width" Value="28"/>
      <Setter Property="Height" Value="28"/>
      <Setter Property="Margin" Value="3,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Grid>
              <Ellipse x:Name="ring" Stroke="Transparent" StrokeThickness="2"/>
              <Ellipse Margin="4"
                       Fill="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="ring" Property="Stroke" Value="{DynamicResource Brush.Accent.Base}"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ring" Property="Stroke" Value="{DynamicResource Brush.Border.Strong}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="StrokeBtn" TargetType="RadioButton">
      <Setter Property="Width" Value="32"/>
      <Setter Property="Height" Value="32"/>
      <Setter Property="Margin" Value="2,0"/>
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="bd" Background="Transparent" CornerRadius="6">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.Bg.Surface2}"/>
                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#1F2DD4BF"/>
                <Setter Property="Foreground" Value="{DynamicResource Brush.Accent.Base}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
</Window>
