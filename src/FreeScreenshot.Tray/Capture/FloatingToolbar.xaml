<Window x:Class="FreeScreenshot.Capture.FloatingToolbar"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FreeScreenshot"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        SizeToContent="WidthAndHeight"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        KeyDown="OnKeyDown">
  <Border Background="#F2112528"
          BorderBrush="#FF1F3A3D" BorderThickness="1"
          CornerRadius="999" Padding="6"
          Effect="{x:Null}">
    <StackPanel Orientation="Horizontal" x:Name="ButtonsHost"/>
  </Border>
</Window>
