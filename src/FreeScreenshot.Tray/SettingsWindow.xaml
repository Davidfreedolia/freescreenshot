<Window x:Class="FreeScreenshot.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="720" Height="620"
        MinWidth="560" MinHeight="460"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.Bg.Base}"
        FontFamily="{DynamicResource Font.Ui}"
        Foreground="{DynamicResource Brush.Text.Primary}"
        ResizeMode="CanResize"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="200"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <Border Grid.Column="0" Background="{DynamicResource Brush.Bg.Surface1}"
            BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="0,0,1,0">
      <StackPanel Margin="12,16,12,16">
        <TextBlock Text="freescreenshot" FontSize="14" FontWeight="SemiBold" Margin="6,0,0,2"/>
        <TextBlock x:Name="SidebarSubtitle" FontSize="11"
                   Foreground="{DynamicResource Brush.Text.Muted}" Margin="6,0,0,18"/>
        <RadioButton x:Name="NavGeneral" GroupName="nav" Style="{DynamicResource NavRadio}"
                     IsChecked="True" Checked="OnNavChanged"/>
        <RadioButton x:Name="NavPrivacy" GroupName="nav" Style="{DynamicResource NavRadio}"
                     Checked="OnNavChanged"/>
        <RadioButton x:Name="NavAbout" GroupName="nav" Style="{DynamicResource NavRadio}"
                     Checked="OnNavChanged"/>
      </StackPanel>
    </Border>

    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid Margin="32,28,32,24">
      <!-- General -->
      <StackPanel x:Name="PageGeneral" Visibility="Visible">
        <TextBlock x:Name="GenH" FontSize="22" FontWeight="SemiBold"/>
        <TextBlock x:Name="GenSub" Foreground="{DynamicResource Brush.Text.Secondary}" Margin="0,4,0,24"/>

        <DockPanel LastChildFill="True" Margin="0,0,0,16">
          <TextBlock x:Name="GenLangLbl" DockPanel.Dock="Left" VerticalAlignment="Center"
                     MinWidth="120" Foreground="{DynamicResource Brush.Text.Primary}" FontWeight="SemiBold"/>
          <ComboBox x:Name="LangCombo" HorizontalAlignment="Left" Width="220" SelectionChanged="OnLangChanged"
                    Background="{DynamicResource Brush.Bg.Surface2}"
                    Foreground="{DynamicResource Brush.Text.Primary}"
                    BorderBrush="{DynamicResource Brush.Border.Subtle}" Padding="8">
            <ComboBoxItem Tag="ca" Content="Català"/>
            <ComboBoxItem Tag="es" Content="Castellano"/>
            <ComboBoxItem Tag="en" Content="English"/>
          </ComboBox>
        </DockPanel>

        <Separator Margin="0,16,0,16" Background="{DynamicResource Brush.Border.Subtle}"/>

        <TextBlock x:Name="OutH" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
        <TextBlock x:Name="OutFolderLbl" Foreground="{DynamicResource Brush.Text.Primary}"
                   FontWeight="SemiBold" Margin="0,4,0,4"/>
        <TextBlock x:Name="CaptureFolderText" Margin="0,0,0,8"
                   FontFamily="{DynamicResource Font.Mono}" FontSize="12"
                   Foreground="{DynamicResource Brush.Text.Secondary}"
                   TextTrimming="CharacterEllipsis" ToolTipService.ShowDuration="20000"/>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
          <Button x:Name="OutBrowseBtn" Padding="10,6" Margin="0,0,8,0" Click="OnBrowseCaptureFolder"
                  Background="{DynamicResource Brush.Bg.Surface2}"
                  Foreground="{DynamicResource Brush.Text.Primary}"
                  BorderBrush="{DynamicResource Brush.Border.Subtle}" Cursor="Hand"/>
          <Button x:Name="OutOpenBtn" Padding="10,6" Click="OnOpenCaptureFolder"
                  Background="{DynamicResource Brush.Bg.Surface2}"
                  Foreground="{DynamicResource Brush.Text.Primary}"
                  BorderBrush="{DynamicResource Brush.Border.Subtle}" Cursor="Hand"/>
        </StackPanel>

        <Separator Margin="0,20,0,16" Background="{DynamicResource Brush.Border.Subtle}"/>

        <TextBlock x:Name="CapH" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>

        <Border Background="{DynamicResource Brush.Bg.Surface1}"
                BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="1"
                CornerRadius="10" Padding="14" Margin="0,4,0,8">
          <DockPanel LastChildFill="True">
            <CheckBox x:Name="EditorToggle" DockPanel.Dock="Right" VerticalAlignment="Center"
                      Margin="16,0,0,0"
                      Checked="OnEditorChanged" Unchecked="OnEditorChanged"/>
            <StackPanel>
              <TextBlock x:Name="EditorTitle" FontWeight="SemiBold"/>
              <TextBlock x:Name="EditorDesc" Foreground="{DynamicResource Brush.Text.Muted}"
                         Margin="0,2,0,0" TextWrapping="Wrap"/>
            </StackPanel>
          </DockPanel>
        </Border>

        <Border Background="{DynamicResource Brush.Bg.Surface1}"
                BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="1"
                CornerRadius="10" Padding="14">
          <DockPanel LastChildFill="True">
            <CheckBox x:Name="SoundToggle" DockPanel.Dock="Right" VerticalAlignment="Center"
                      Margin="16,0,0,0"
                      Checked="OnSoundChanged" Unchecked="OnSoundChanged"/>
            <StackPanel>
              <TextBlock x:Name="SoundTitle" FontWeight="SemiBold"/>
              <TextBlock x:Name="SoundDesc" Foreground="{DynamicResource Brush.Text.Muted}"
                         Margin="0,2,0,0" TextWrapping="Wrap"/>
            </StackPanel>
          </DockPanel>
        </Border>

        <TextBlock x:Name="GenPlaceholder" Foreground="{DynamicResource Brush.Text.Muted}" TextWrapping="Wrap" Margin="0,16,0,0"/>
      </StackPanel>

      <!-- Privacy -->
      <StackPanel x:Name="PagePrivacy" Visibility="Collapsed">
        <TextBlock x:Name="PrivH" FontSize="22" FontWeight="SemiBold"/>
        <TextBlock x:Name="PrivSub" Foreground="{DynamicResource Brush.Text.Secondary}"
                   Margin="0,4,0,24" TextWrapping="Wrap"/>

        <Border Background="{DynamicResource Brush.Bg.Surface1}"
                BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="1"
                CornerRadius="10" Padding="16">
          <DockPanel LastChildFill="True">
            <CheckBox x:Name="TrackingToggle" DockPanel.Dock="Right"
                      VerticalAlignment="Center" Margin="16,0,0,0"
                      Checked="OnTrackingChanged" Unchecked="OnTrackingChanged"/>
            <StackPanel>
              <TextBlock x:Name="PrivToggleTitle" FontWeight="SemiBold"/>
              <TextBlock x:Name="PrivToggleDesc" Foreground="{DynamicResource Brush.Text.Muted}"
                         Margin="0,2,0,0" TextWrapping="Wrap"/>
            </StackPanel>
          </DockPanel>
        </Border>

        <TextBlock x:Name="PrivIdLabel" Margin="0,16,0,0" FontSize="12"
                   Foreground="{DynamicResource Brush.Text.Muted}"/>
        <TextBlock x:Name="InstallIdText" FontFamily="{DynamicResource Font.Mono}"
                   Foreground="{DynamicResource Brush.Text.Secondary}" Margin="0,2,0,0"/>

        <Button x:Name="PrivOpenPolicy" Margin="0,20,0,0" HorizontalAlignment="Left"
                Click="OnOpenPrivacy" Background="Transparent"
                Foreground="{DynamicResource Brush.Accent.Base}" BorderThickness="0"
                Padding="0" Cursor="Hand"/>
      </StackPanel>

      <!-- About + Donate -->
      <StackPanel x:Name="PageAbout" Visibility="Collapsed">
        <TextBlock x:Name="AboutH" FontSize="22" FontWeight="SemiBold"/>
        <TextBlock x:Name="AboutSub" Foreground="{DynamicResource Brush.Text.Secondary}" Margin="0,4,0,24"/>

        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <TextBlock Grid.Row="0" Grid.Column="0" x:Name="AbVerLbl" Foreground="{DynamicResource Brush.Text.Muted}" Margin="0,0,0,8"/>
          <TextBlock x:Name="VersionText" Grid.Row="0" Grid.Column="1" Margin="0,0,0,8"
                     FontFamily="{DynamicResource Font.Mono}"/>
          <TextBlock Grid.Row="1" Grid.Column="0" x:Name="AbLicLbl" Foreground="{DynamicResource Brush.Text.Muted}" Margin="0,0,0,8"/>
          <TextBlock Grid.Row="1" Grid.Column="1" Text="GPLv3" Margin="0,0,0,8"/>
          <TextBlock Grid.Row="2" Grid.Column="0" x:Name="AbCodeLbl" Foreground="{DynamicResource Brush.Text.Muted}"/>
          <TextBlock Grid.Row="2" Grid.Column="1" Text="github.com/Davidfreedolia/freescreenshot"
                     FontFamily="{DynamicResource Font.Mono}"/>
        </Grid>

        <Button x:Name="ReplayOnboardingBtn" Margin="0,20,0,0" HorizontalAlignment="Left"
                Padding="12,8" Click="OnReplayOnboarding"
                Background="{DynamicResource Brush.Bg.Surface2}"
                Foreground="{DynamicResource Brush.Text.Primary}"
                BorderBrush="{DynamicResource Brush.Border.Subtle}" Cursor="Hand"/>

        <Border Margin="0,24,0,0" Background="{DynamicResource Brush.Bg.Surface1}"
                BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="1"
                CornerRadius="10" Padding="16">
          <StackPanel>
            <TextBlock x:Name="DonateAboutTitle" FontWeight="SemiBold"/>
            <TextBlock x:Name="DonateAboutSub" Foreground="{DynamicResource Brush.Text.Secondary}"
                       Margin="0,4,0,12" TextWrapping="Wrap"/>
            <Button x:Name="DonateBtn" Padding="14,8" HorizontalAlignment="Left"
                    Background="{DynamicResource Brush.Accent.Base}"
                    Foreground="#FF1A1814" BorderThickness="0"
                    FontWeight="SemiBold" Cursor="Hand"
                    Click="OnDonate"/>
          </StackPanel>
        </Border>
      </StackPanel>
    </Grid>
    </ScrollViewer>
  </Grid>

  <Window.Resources>
    <Style x:Key="NavRadio" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Padding" Value="10,8"/>
      <Setter Property="Margin" Value="0,2"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="bd" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
              <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.Bg.Surface2}"/>
                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#1FA3E635"/>
                <Setter Property="Foreground" Value="{DynamicResource Brush.Accent.Base}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
</Window>
