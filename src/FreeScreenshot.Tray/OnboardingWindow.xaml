<Window x:Class="FreeScreenshot.OnboardingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="620" Height="520"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.Bg.Base}"
        FontFamily="{DynamicResource Font.Ui}"
        Foreground="{DynamicResource Brush.Text.Primary}"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="True"
        Title="FreeScreenshot"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
  <Grid Margin="40,32,40,28">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Logo -->
    <Canvas Grid.Row="0" Width="48" Height="48" HorizontalAlignment="Left">
      <Path Stroke="{DynamicResource Brush.Accent.Base}" StrokeThickness="3"
            StrokeStartLineCap="Square" StrokeEndLineCap="Square"
            Data="M 12 19 L 12 10 L 21 10" />
      <Path Stroke="{DynamicResource Brush.Accent.Base}" StrokeThickness="3"
            StrokeStartLineCap="Square" StrokeEndLineCap="Square"
            Data="M 36 29 L 36 38 L 27 38" />
      <Ellipse Width="5" Height="5" Canvas.Left="21.5" Canvas.Top="21.5"
               Fill="{DynamicResource Brush.Accent.Base}" />
    </Canvas>

    <StackPanel Grid.Row="1" Margin="0,16,0,12">
      <TextBlock x:Name="WelcomeTitle" FontSize="24" FontWeight="SemiBold"/>
      <TextBlock x:Name="WelcomeSub" FontSize="14" Margin="0,4,0,0"
                 Foreground="{DynamicResource Brush.Text.Secondary}" TextWrapping="Wrap"/>
    </StackPanel>

    <StackPanel Grid.Row="2" Margin="0,12,0,0">
      <Border Background="{DynamicResource Brush.Bg.Surface1}"
              BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="1"
              CornerRadius="10" Padding="16" Margin="0,0,0,10">
        <StackPanel>
          <TextBlock x:Name="Step1Title" FontWeight="SemiBold"/>
          <TextBlock x:Name="Step1Body" Foreground="{DynamicResource Brush.Text.Secondary}"
                     Margin="0,4,0,0" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>

      <Border Background="{DynamicResource Brush.Bg.Surface1}"
              BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="1"
              CornerRadius="10" Padding="16" Margin="0,0,0,10">
        <StackPanel>
          <TextBlock x:Name="Step2Title" FontWeight="SemiBold"/>
          <TextBlock x:Name="Step2Body" Foreground="{DynamicResource Brush.Text.Secondary}"
                     Margin="0,4,0,0" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>

      <Border Background="{DynamicResource Brush.Bg.Surface1}"
              BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="1"
              CornerRadius="10" Padding="16">
        <StackPanel>
          <TextBlock x:Name="Step3Title" FontWeight="SemiBold"/>
          <TextBlock x:Name="Step3Body" Foreground="{DynamicResource Brush.Text.Secondary}"
                     Margin="0,4,0,0" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>
    </StackPanel>

    <DockPanel Grid.Row="3" Margin="0,18,0,0" LastChildFill="False">
      <Button x:Name="DoneBtn" DockPanel.Dock="Right" Padding="18,10" MinWidth="148"
              Background="{DynamicResource Brush.Accent.Base}"
              Foreground="#FF1A1814" BorderThickness="0"
              FontWeight="SemiBold" Cursor="Hand"
              Click="OnDone"/>
      <Button x:Name="SettingsBtn" DockPanel.Dock="Right" Padding="14,10" Margin="0,0,8,0"
              Background="{DynamicResource Brush.Bg.Surface2}"
              Foreground="{DynamicResource Brush.Text.Primary}"
              BorderBrush="{DynamicResource Brush.Border.Subtle}" Cursor="Hand"
              Click="OnSettings"/>
    </DockPanel>
  </Grid>
</Window>
