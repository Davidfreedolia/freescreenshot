<Window x:Class="FreeScreenshot.OnboardingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="700" Height="720"
        MinWidth="560" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.Bg.Base}"
        FontFamily="{DynamicResource Font.Ui}"
        Foreground="{DynamicResource Brush.Text.Primary}"
        ResizeMode="CanResize"
        Topmost="True"
        ShowInTaskbar="True"
        Title="FreeScreenshot"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
  <Grid Margin="40,32,40,28">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Big lime logo tile -->
    <Border Grid.Row="0" Width="56" Height="56" HorizontalAlignment="Left" CornerRadius="12">
      <Border.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
          <GradientStop Color="#FFBEF264" Offset="0"/>
          <GradientStop Color="#FF84CC16" Offset="1"/>
        </LinearGradientBrush>
      </Border.Background>
      <Canvas>
        <Path Stroke="#FF1A1814" StrokeThickness="3" StrokeStartLineCap="Square" StrokeEndLineCap="Square"
              Data="M 14 22 L 14 12 L 24 12"/>
        <Path Stroke="#FF1A1814" StrokeThickness="3" StrokeStartLineCap="Square" StrokeEndLineCap="Square"
              Data="M 42 34 L 42 44 L 32 44"/>
        <Ellipse Width="6" Height="6" Canvas.Left="25" Canvas.Top="25" Fill="#FF1A1814"/>
      </Canvas>
    </Border>

    <StackPanel Grid.Row="1" Margin="0,16,0,16">
      <TextBlock x:Name="WelcomeTitle" FontSize="26" FontWeight="SemiBold"/>
      <TextBlock x:Name="WelcomeSub" FontSize="14" Margin="0,6,0,0"
                 Foreground="{DynamicResource Brush.Text.Secondary}" TextWrapping="Wrap"/>
    </StackPanel>

    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel>

        <!-- STEP 1 -->
        <Border Background="{DynamicResource Brush.Bg.Surface1}"
                BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="1"
                CornerRadius="12" Padding="16" Margin="0,0,0,12">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="44"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="80"/>
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0" VerticalAlignment="Top">
              <Ellipse Width="36" Height="36" Fill="{DynamicResource Brush.Accent.Base}"/>
              <TextBlock Text="1" FontWeight="Bold" FontSize="16" Foreground="#FF1A1814"
                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
            <StackPanel Grid.Column="1" Margin="12,0,12,0">
              <TextBlock x:Name="Step1Title" FontWeight="SemiBold" FontSize="15"/>
              <TextBlock x:Name="Step1Body" Foreground="{DynamicResource Brush.Text.Secondary}"
                         Margin="0,6,0,0" TextWrapping="Wrap" LineHeight="20"/>
            </StackPanel>
            <!-- Illustration: taskbar with up-arrow + icon -->
            <Canvas Grid.Column="2" Width="80" Height="64" VerticalAlignment="Center">
              <Rectangle Width="80" Height="22" Canvas.Top="32" Fill="#FF2F2C27" RadiusX="4" RadiusY="4"/>
              <Path Stroke="{DynamicResource Brush.Accent.Base}" StrokeThickness="2"
                    StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                    Data="M 8 48 L 14 42 L 20 48" Fill="Transparent"/>
              <Rectangle Width="14" Height="14" Canvas.Left="26" Canvas.Top="36" RadiusX="3" RadiusY="3" Fill="#FF1A1814"/>
              <Path Canvas.Left="26" Canvas.Top="36" Stroke="{DynamicResource Brush.Accent.Base}" StrokeThickness="1.4"
                    Data="M 3 6 L 3 3 L 6 3 M 11 8 L 11 11 L 8 11"/>
              <Ellipse Width="2.6" Height="2.6" Canvas.Left="32" Canvas.Top="42"
                       Fill="{DynamicResource Brush.Accent.Base}"/>
            </Canvas>
          </Grid>
        </Border>

        <!-- STEP 2 -->
        <Border Background="{DynamicResource Brush.Bg.Surface1}"
                BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="1"
                CornerRadius="12" Padding="16" Margin="0,0,0,12">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="44"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="80"/>
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0" VerticalAlignment="Top">
              <Ellipse Width="36" Height="36" Fill="{DynamicResource Brush.Accent.Base}"/>
              <TextBlock Text="2" FontWeight="Bold" FontSize="16" Foreground="#FF1A1814"
                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
            <StackPanel Grid.Column="1" Margin="12,0,12,0">
              <TextBlock x:Name="Step2Title" FontWeight="SemiBold" FontSize="15"/>
              <TextBlock x:Name="Step2Body" Foreground="{DynamicResource Brush.Text.Secondary}"
                         Margin="0,6,0,0" TextWrapping="Wrap" LineHeight="20"/>
            </StackPanel>
            <!-- Illustration: dashed selection rectangle with crosshair -->
            <Canvas Grid.Column="2" Width="80" Height="64" VerticalAlignment="Center">
              <Rectangle Width="64" Height="44" Canvas.Left="8" Canvas.Top="10"
                         Stroke="{DynamicResource Brush.Accent.Base}" StrokeThickness="1.6"
                         StrokeDashArray="3 3" Fill="#1FA3E635"/>
              <!-- Crosshair / pointer near bottom-right corner -->
              <Path Canvas.Left="50" Canvas.Top="36" Stroke="{DynamicResource Brush.Text.Primary}"
                    StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                    Data="M 0 0 L 18 18 M 11 16 L 18 18 L 16 11"/>
            </Canvas>
          </Grid>
        </Border>

        <!-- STEP 3 -->
        <Border Background="{DynamicResource Brush.Bg.Surface1}"
                BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="1"
                CornerRadius="12" Padding="16" Margin="0,0,0,12">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="44"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="80"/>
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0" VerticalAlignment="Top">
              <Ellipse Width="36" Height="36" Fill="{DynamicResource Brush.Accent.Base}"/>
              <TextBlock Text="3" FontWeight="Bold" FontSize="16" Foreground="#FF1A1814"
                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
            <StackPanel Grid.Column="1" Margin="12,0,12,0">
              <TextBlock x:Name="Step3Title" FontWeight="SemiBold" FontSize="15"/>
              <TextBlock x:Name="Step3Body" Foreground="{DynamicResource Brush.Text.Secondary}"
                         Margin="0,6,0,0" TextWrapping="Wrap" LineHeight="20"/>
            </StackPanel>
            <!-- Illustration: folder with a tiny picture inside -->
            <Canvas Grid.Column="2" Width="80" Height="64" VerticalAlignment="Center">
              <Path Stroke="{DynamicResource Brush.Accent.Base}" StrokeThickness="1.8"
                    StrokeLineJoin="Round" Fill="#1FA3E635"
                    Data="M 8 18 L 28 18 L 34 24 L 72 24 L 72 56 L 8 56 Z"/>
              <Rectangle Width="22" Height="14" Canvas.Left="32" Canvas.Top="32"
                         Fill="{DynamicResource Brush.Text.Primary}" RadiusX="2" RadiusY="2"/>
              <Ellipse Width="5" Height="5" Canvas.Left="37" Canvas.Top="35"
                       Fill="{DynamicResource Brush.Bg.Surface1}"/>
              <Path Canvas.Left="32" Canvas.Top="32" Stroke="{DynamicResource Brush.Bg.Surface1}" StrokeThickness="1.5"
                    Data="M 0 12 L 6 7 L 11 11 L 16 5 L 22 12 L 22 14 L 0 14 Z"
                    Fill="{DynamicResource Brush.Bg.Surface1}"/>
            </Canvas>
          </Grid>
        </Border>

      </StackPanel>
    </ScrollViewer>

    <DockPanel Grid.Row="3" Margin="0,18,0,0" LastChildFill="False">
      <Button x:Name="DoneBtn" DockPanel.Dock="Right" Padding="18,10" MinWidth="148"
              Background="{DynamicResource Brush.Accent.Base}"
              Foreground="#FF1A1814" BorderThickness="0"
              FontWeight="SemiBold" Cursor="Hand"
              Click="OnDone"/>
      <Button x:Name="SettingsBtn" DockPanel.Dock="Right" Padding="14,10" Margin="0,0,8,0"
              Background="{DynamicResource Brush.Bg.Surface2}"
              Foreground="{DynamicResource Brush.Text.Primary}"
              BorderBrush="{DynamicResource Brush.Border.Subtle}" Cursor="Hand"
              Click="OnSettings"/>
    </DockPanel>
  </Grid>
</Window>
