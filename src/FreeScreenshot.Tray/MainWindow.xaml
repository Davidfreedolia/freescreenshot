<Window x:Class="FreeScreenshot.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FreeScreenshot"
        Width="560" Height="380"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.Bg.Base}"
        FontFamily="{DynamicResource Font.Ui}"
        Foreground="{DynamicResource Brush.Text.Primary}"
        ResizeMode="CanMinimize"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

  <Grid Margin="48">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Mark: viewfinder brackets + dot (logo) -->
    <Canvas Grid.Row="0" Width="56" Height="56" HorizontalAlignment="Left">
      <Path Stroke="{DynamicResource Brush.Accent.Base}" StrokeThickness="3.2"
            StrokeStartLineCap="Square" StrokeEndLineCap="Square"
            Data="M 14 22 L 14 12 L 24 12" />
      <Path Stroke="{DynamicResource Brush.Accent.Base}" StrokeThickness="3.2"
            StrokeStartLineCap="Square" StrokeEndLineCap="Square"
            Data="M 42 34 L 42 44 L 32 44" />
      <Ellipse Width="6" Height="6" Canvas.Left="25" Canvas.Top="25"
               Fill="{DynamicResource Brush.Accent.Base}" />
    </Canvas>

    <StackPanel Grid.Row="1" Margin="0,24,0,0">
      <TextBlock Text="freescreenshot"
                 FontSize="32" FontWeight="SemiBold"
                 Foreground="{DynamicResource Brush.Text.Primary}"/>
      <TextBlock Text="Captures sense embuts."
                 FontSize="15"
                 Margin="0,4,0,0"
                 Foreground="{DynamicResource Brush.Text.Secondary}"/>
    </StackPanel>

    <StackPanel Grid.Row="2" VerticalAlignment="Center" Margin="0,16,0,0">
      <TextBlock TextWrapping="Wrap" FontSize="13"
                 Foreground="{DynamicResource Brush.Text.Secondary}"
                 LineHeight="20">
        Hola. Aquesta és la finestra placeholder. Aviat aquí no hi haurà res
        — l'app viurà a la safata, esperant la teva drecera.
      </TextBlock>
    </StackPanel>

    <DockPanel Grid.Row="3" LastChildFill="False">
      <TextBlock DockPanel.Dock="Left"
                 FontSize="11" Foreground="{DynamicResource Brush.Text.Muted}"
                 VerticalAlignment="Center">
        v0.0.1 · pre-alfa · una eina de freedolia.com
      </TextBlock>
      <Button DockPanel.Dock="Right" Content="Tancar"
              Padding="16,8" MinWidth="92" Click="OnCloseClick"
              Background="{DynamicResource Brush.Accent.Base}"
              Foreground="#FF1A1814"
              BorderThickness="0"
              FontWeight="SemiBold"
              Cursor="Hand"/>
    </DockPanel>
  </Grid>
</Window>
