<Window x:Class="Freezshot.UninstallFeedbackWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="520" Height="540"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.Bg.Base}"
        FontFamily="{DynamicResource Font.Ui}"
        Foreground="{DynamicResource Brush.Text.Primary}"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="True"
        Title="Freezshot"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

  <Grid Margin="32,28,32,24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0" x:Name="TitleText" FontSize="22" FontWeight="SemiBold"/>
    <TextBlock Grid.Row="1" x:Name="SubText" Margin="0,4,0,18"
               Foreground="{DynamicResource Brush.Text.Secondary}" TextWrapping="Wrap"/>

    <StackPanel Grid.Row="2">
      <CheckBox x:Name="R1" Margin="0,4" Foreground="{DynamicResource Brush.Text.Primary}"/>
      <CheckBox x:Name="R2" Margin="0,4" Foreground="{DynamicResource Brush.Text.Primary}"/>
      <CheckBox x:Name="R3" Margin="0,4" Foreground="{DynamicResource Brush.Text.Primary}"/>
      <CheckBox x:Name="R4" Margin="0,4" Foreground="{DynamicResource Brush.Text.Primary}"/>
      <CheckBox x:Name="R5" Margin="0,4" Foreground="{DynamicResource Brush.Text.Primary}"/>
      <CheckBox x:Name="R6" Margin="0,4" Foreground="{DynamicResource Brush.Text.Primary}"/>
      <CheckBox x:Name="R7" Margin="0,4" Foreground="{DynamicResource Brush.Text.Primary}"/>
      <CheckBox x:Name="R8" Margin="0,4" Foreground="{DynamicResource Brush.Text.Primary}"/>
    </StackPanel>

    <TextBox Grid.Row="3" x:Name="NoteBox" Margin="0,12,0,0"
             Height="64" TextWrapping="Wrap" AcceptsReturn="True"
             VerticalScrollBarVisibility="Auto"
             Background="{DynamicResource Brush.Bg.Surface1}"
             Foreground="{DynamicResource Brush.Text.Primary}"
             BorderBrush="{DynamicResource Brush.Border.Subtle}"
             Padding="8"/>

    <DockPanel Grid.Row="4" Margin="0,16,0,0" LastChildFill="False">
      <Button x:Name="SendBtn" DockPanel.Dock="Right" Padding="16,8" MinWidth="148"
              Click="OnSend"
              Background="{DynamicResource Brush.Accent.Base}"
              Foreground="#FF1A1814" BorderThickness="0"
              FontWeight="SemiBold" Cursor="Hand"/>
      <Button x:Name="SkipBtn" DockPanel.Dock="Right" Padding="16,8" MinWidth="92"
              Margin="0,0,8,0" Click="OnSkip"
              Background="{DynamicResource Brush.Bg.Surface2}"
              Foreground="{DynamicResource Brush.Text.Primary}"
              BorderBrush="{DynamicResource Brush.Border.Subtle}" Cursor="Hand"/>
    </DockPanel>
  </Grid>
</Window>
