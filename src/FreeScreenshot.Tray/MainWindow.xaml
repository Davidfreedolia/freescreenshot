<Window x:Class="FreeScreenshot.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FreeScreenshot"
        Width="580" Height="420"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.Bg.Base}"
        FontFamily="{DynamicResource Font.Ui}"
        Foreground="{DynamicResource Brush.Text.Primary}"
        ResizeMode="CanMinimize"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

  <Grid Margin="48">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Canvas Grid.Row="0" Width="56" Height="56" HorizontalAlignment="Left">
      <Path Stroke="{DynamicResource Brush.Accent.Base}" StrokeThickness="3.2"
            StrokeStartLineCap="Square" StrokeEndLineCap="Square"
            Data="M 14 22 L 14 12 L 24 12" />
      <Path Stroke="{DynamicResource Brush.Accent.Base}" StrokeThickness="3.2"
            StrokeStartLineCap="Square" StrokeEndLineCap="Square"
            Data="M 42 34 L 42 44 L 32 44" />
      <Ellipse Width="6" Height="6" Canvas.Left="25" Canvas.Top="25"
               Fill="{DynamicResource Brush.Accent.Base}" />
    </Canvas>

    <StackPanel Grid.Row="1" Margin="0,24,0,0">
      <TextBlock Text="freescreenshot" FontSize="32" FontWeight="SemiBold"/>
      <TextBlock x:Name="TaglineText" FontSize="15" Margin="0,4,0,0"
                 Foreground="{DynamicResource Brush.Text.Secondary}"/>
    </StackPanel>

    <StackPanel Grid.Row="2" VerticalAlignment="Center" Margin="0,16,0,0">
      <TextBlock x:Name="DonateHeader" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6"/>
      <TextBlock x:Name="DonateSub" TextWrapping="Wrap" FontSize="12"
                 Foreground="{DynamicResource Brush.Text.Secondary}"
                 LineHeight="18" Margin="0,0,0,12"/>
      <Button x:Name="DonateBtn" Padding="14,8" HorizontalAlignment="Left"
              Background="{DynamicResource Brush.Accent.Base}"
              Foreground="#FF1A1814" BorderThickness="0"
              FontWeight="SemiBold" Cursor="Hand"
              Click="OnDonateClick"/>
    </StackPanel>

    <StackPanel Grid.Row="3">
      <TextBlock x:Name="VersionFooter" FontSize="11"
                 Foreground="{DynamicResource Brush.Text.Muted}"/>
    </StackPanel>

    <DockPanel Grid.Row="4" Margin="0,16,0,0" LastChildFill="False">
      <Button x:Name="CloseBtn" DockPanel.Dock="Right" Padding="16,8" MinWidth="92" Click="OnCloseClick"
              Background="{DynamicResource Brush.Bg.Surface2}"
              Foreground="{DynamicResource Brush.Text.Primary}"
              BorderBrush="{DynamicResource Brush.Border.Subtle}" Cursor="Hand"/>
    </DockPanel>
  </Grid>
</Window>
