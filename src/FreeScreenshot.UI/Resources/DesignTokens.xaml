<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- =========================================
       Freedolia Design Tokens — Dark Mode
       Mirror of DESIGN-SYSTEM.md
       ========================================= -->

  <!-- Backgrounds -->
  <Color x:Key="Color.Bg.Base">#FF1A1814</Color>
  <Color x:Key="Color.Bg.Surface1">#FF25221E</Color>
  <Color x:Key="Color.Bg.Surface2">#FF2F2C27</Color>
  <Color x:Key="Color.Bg.Surface3">#FF3A3631</Color>

  <!-- Borders -->
  <Color x:Key="Color.Border.Subtle">#FF3A3631</Color>
  <Color x:Key="Color.Border.Strong">#FF524C44</Color>

  <!-- Text -->
  <Color x:Key="Color.Text.Primary">#FFF5F2EC</Color>
  <Color x:Key="Color.Text.Secondary">#FFA8A39B</Color>
  <Color x:Key="Color.Text.Muted">#FF6B6760</Color>
  <Color x:Key="Color.Text.Disabled">#FF4A4640</Color>

  <!-- Accent: lime -->
  <Color x:Key="Color.Accent.Base">#FFA3E635</Color>
  <Color x:Key="Color.Accent.Hover">#FFBEF264</Color>
  <Color x:Key="Color.Accent.Pressed">#FF84CC16</Color>

  <!-- Feedback -->
  <Color x:Key="Color.Feedback.Warning">#FFFBBF24</Color>
  <Color x:Key="Color.Feedback.Error">#FFF87171</Color>

  <!-- Brushes (use these in styles) -->
  <SolidColorBrush x:Key="Brush.Bg.Base" Color="{StaticResource Color.Bg.Base}" />
  <SolidColorBrush x:Key="Brush.Bg.Surface1" Color="{StaticResource Color.Bg.Surface1}" />
  <SolidColorBrush x:Key="Brush.Bg.Surface2" Color="{StaticResource Color.Bg.Surface2}" />
  <SolidColorBrush x:Key="Brush.Bg.Surface3" Color="{StaticResource Color.Bg.Surface3}" />
  <SolidColorBrush x:Key="Brush.Border.Subtle" Color="{StaticResource Color.Border.Subtle}" />
  <SolidColorBrush x:Key="Brush.Border.Strong" Color="{StaticResource Color.Border.Strong}" />
  <SolidColorBrush x:Key="Brush.Text.Primary" Color="{StaticResource Color.Text.Primary}" />
  <SolidColorBrush x:Key="Brush.Text.Secondary" Color="{StaticResource Color.Text.Secondary}" />
  <SolidColorBrush x:Key="Brush.Text.Muted" Color="{StaticResource Color.Text.Muted}" />
  <SolidColorBrush x:Key="Brush.Accent.Base" Color="{StaticResource Color.Accent.Base}" />
  <SolidColorBrush x:Key="Brush.Accent.Hover" Color="{StaticResource Color.Accent.Hover}" />

  <!-- Sizes -->
  <CornerRadius x:Key="Radius.Sm">6</CornerRadius>
  <CornerRadius x:Key="Radius.Md">10</CornerRadius>
  <CornerRadius x:Key="Radius.Lg">14</CornerRadius>

  <Thickness x:Key="Pad.Sm">8</Thickness>
  <Thickness x:Key="Pad.Md">12</Thickness>
  <Thickness x:Key="Pad.Lg">16</Thickness>

  <!-- Fonts -->
  <FontFamily x:Key="Font.Ui">Segoe UI Variable Display, Segoe UI, system-ui</FontFamily>
  <FontFamily x:Key="Font.Mono">Cascadia Mono, Consolas, monospace</FontFamily>

</ResourceDictionary>
