<Window x:Class="Freezshot.Capture.SelectionOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Freezshot — selecció"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Cursor="Cross"
        KeyDown="OnKeyDown"
        MouseLeftButtonDown="OnMouseDown"
        MouseMove="OnMouseMove"
        MouseLeftButtonUp="OnMouseUp">
  <Canvas x:Name="Root" Background="Transparent">
    <Rectangle x:Name="DimTop"    Fill="#8C141210"/>
    <Rectangle x:Name="DimBottom" Fill="#8C141210"/>
    <Rectangle x:Name="DimLeft"   Fill="#8C141210"/>
    <Rectangle x:Name="DimRight"  Fill="#8C141210"/>

    <Rectangle x:Name="SelBorder"
               Stroke="#FF2DD4BF" StrokeThickness="1.5"
               Visibility="Collapsed"/>

    <Border x:Name="SizeChip" Background="#E6112528"
            BorderBrush="#FF1F3A3D" BorderThickness="1"
            CornerRadius="8" Padding="8,4"
            Visibility="Collapsed">
      <TextBlock x:Name="SizeText" Foreground="#FF2DD4BF"
                 FontFamily="Cascadia Mono, Consolas, monospace"
                 FontWeight="SemiBold"
                 FontSize="11"/>
    </Border>

    <TextBlock x:Name="HintText" Foreground="#FFF0FAF7" FontSize="14" FontWeight="SemiBold">
      <TextBlock.Effect>
        <DropShadowEffect Color="#FF000000" Opacity="0.85" BlurRadius="8" ShadowDepth="0"/>
      </TextBlock.Effect>
    </TextBlock>
  </Canvas>
</Window>
